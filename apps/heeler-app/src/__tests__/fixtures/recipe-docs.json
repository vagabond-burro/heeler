 "depth_color_matte": {
  "heeler_recipe": 1,
  "name": "Depth and Color Matte",
  "description": "A mask by distance and by color at once: a band of depth and a band of hue, where both hold or where either does",
  "keywords": "mask matte hue depth range distance",
  "inputs": [
   {
    "port": "in",
    "to": [
     "hue.in"
    ]
   },
   {
    "port": "depth",
    "to": [
     "depth.in"
    ]
   }
  ],
  "output": "combine",
  "nodes": [
