    "at": [
     170,
     300
    ],
    "params": {
     "metric": "blue"
    }
   },
   {
    "id": "b_b",
    "type": "heeler.measure",
    "name": "B Blue",
    "at": [
     340,
     400
    ],
    "params": {
     "metric": "blue"
    }
   },
   {
    "id": "op_b",
    "type": "heeler.math",
    "name": "Blue A op B",
    "at": [
     510,
     300
    ],
    "params": {
     "op": "add"
    }
   },
   {
    "id": "join",
    "type": "heeler.channel_join",
    "name": "Result",
    "at": [
     680,
     200
