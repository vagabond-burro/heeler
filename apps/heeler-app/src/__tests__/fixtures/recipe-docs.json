   {
    "from": "b_r.out",
    "to": "op_r.in2"
   },
   {
    "from": "op_r.out",
    "to": "join.in"
   },
   {
    "from": "a.out",
    "to": "a_g.in"
   },
   {
    "from": "b.out",
    "to": "b_g.in"
   },
   {
    "from": "a_g.out",
    "to": "op_g.in"
   },
   {
    "from": "b_g.out",
