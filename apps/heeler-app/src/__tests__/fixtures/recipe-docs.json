{
 "frequency_separation": {
  "heeler_recipe": 1,
  "name": "Frequency Separation",
  "description": "Retouch tone and texture apart: smooth color in the low branch, fix detail in the high, and they add back to the picture",
  "keywords": "retouch skin low high blur detail",
  "inputs": [
   {
    "port": "in",
    "to": [
     "picture.in"
    ]
   }
  ],
  "output": "result",
  "nodes": [
   {
    "id": "picture",
    "type": "heeler.merge",
    "name": "Picture",
    "at": [
     0,
     200
    ]
   },
   {
    "id": "blur",
    "type": "heeler.blur",
    "name": "Low (blur)",
    "at": [
     170,
     0
    ],
    "params": {
     "radius": 8,
     "kind": "gaussian"
    }
   },
   {
    "id": "alpha",
    "type": "heeler.measure",
    "name": "Picture alpha",
    "at": [
     850,
     500
    ],
    "params": {
     "metric": "alpha"
    }
   },
   {
    "id": "pic_r",
    "type": "heeler.measure",
    "name": "Picture Red",
    "at": [
     170,
     200
    ],
    "params": {
     "metric": "red"
    }
   },
   {
    "id": "low_r",
    "type": "heeler.measure",
    "name": "Low Red",
    "at": [
     340,
     200
    ],
    "params": {
     "metric": "red"
    }
   },
   {
    "id": "high_r",
    "type": "heeler.math",
    "name": "High Red",
    "at": [
     510,
     200
    ],
    "params": {
     "op": "subtract"
    }
   },
   {
    "id": "back_low_r",
    "type": "heeler.measure",
    "name": "Edited low Red",
    "at": [
     1020,
     0
    ],
    "params": {
     "metric": "red"
    }
   },
   {
    "id": "back_high_r",
    "type": "heeler.measure",
    "name": "Edited high Red",
    "at": [
     1020,
     300
    ],
    "params": {
     "metric": "red"
    }
   },
   {
    "id": "sum_r",
    "type": "heeler.math",
    "name": "Red low plus high",
    "at": [
     1190,
     100
    ],
    "params": {
     "op": "add"
    }
   },
   {
    "id": "pic_g",
    "type": "heeler.measure",
    "name": "Picture Green",
    "at": [
     170,
     300
    ],
    "params": {
     "metric": "green"
    }
   },
   {
    "id": "low_g",
    "type": "heeler.measure",
    "name": "Low Green",
    "at": [
     340,
     300
    ],
    "params": {
     "metric": "green"
    }
   },
   {
    "id": "high_g",
    "type": "heeler.math",
    "name": "High Green",
    "at": [
     510,
     300
    ],
    "params": {
     "op": "subtract"
    }
   },
   {
    "id": "back_low_g",
    "type": "heeler.measure",
    "name": "Edited low Green",
    "at": [
     1020,
     100
    ],
    "params": {
     "metric": "green"
    }
   },
   {
    "id": "back_high_g",
    "type": "heeler.measure",
    "name": "Edited high Green",
    "at": [
     1020,
     400
    ],
    "params": {
     "metric": "green"
    }
   },
   {
    "id": "sum_g",
    "type": "heeler.math",
    "name": "Green low plus high",
    "at": [
     1190,
     200
    ],
    "params": {
     "op": "add"
    }
   },
   {
    "id": "pic_b",
    "type": "heeler.measure",
    "name": "Picture Blue",
    "at": [
     170,
     400
    ],
    "params": {
     "metric": "blue"
    }
   },
   {
    "id": "low_b",
    "type": "heeler.measure",
    "name": "Low Blue",
    "at": [
     340,
     400
    ],
    "params": {
     "metric": "blue"
    }
   },
   {
    "id": "high_b",
    "type": "heeler.math",
    "name": "High Blue",
    "at": [
     510,
     400
    ],
    "params": {
     "op": "subtract"
    }
   },
   {
    "id": "back_low_b",
    "type": "heeler.measure",
    "name": "Edited low Blue",
    "at": [
     1020,
     200
    ],
    "params": {
     "metric": "blue"
    }
   },
   {
    "id": "back_high_b",
    "type": "heeler.measure",
    "name": "Edited high Blue",
    "at": [
     1020,
     500
    ],
    "params": {
     "metric": "blue"
    }
   },
   {
    "id": "sum_b",
    "type": "heeler.math",
    "name": "Blue low plus high",
    "at": [
     1190,
     300
    ],
    "params": {
     "op": "add"
    }
   },
   {
    "id": "high",
    "type": "heeler.channel_join",
    "name": "High (detail)",
    "at": [
     680,
     300
    ]
   },
   {
    "id": "edit_low",
    "type": "heeler.merge",
    "name": "Edit low here",
    "note": "Splice tone and color edits after this node",
    "at": [
     680,
     0
    ]
   },
   {
    "id": "edit_high",
    "type": "heeler.merge",
    "name": "Edit high here",
    "note": "Splice detail edits after this node; values are signed around zero",
    "at": [
     850,
     300
    ]
   },
   {
    "id": "result",
    "type": "heeler.channel_join",
    "name": "Low plus high",
    "at": [
     1360,
     200
    ]
   }
  ],
  "wires": [
   {
    "from": "picture.out",
    "to": "blur.in"
   },
   {
    "from": "blur.out",
    "to": "edit_low.in"
   },
   {
    "from": "picture.out",
    "to": "alpha.in"
   },
   {
    "from": "picture.out",
    "to": "pic_r.in"
   },
   {
    "from": "blur.out",
    "to": "low_r.in"
   },
   {
    "from": "pic_r.out",
    "to": "high_r.in"
   },
   {
    "from": "low_r.out",
    "to": "high_r.in2"
   },
   {
    "from": "high_r.out",
    "to": "high.in"
   },
   {
    "from": "edit_low.out",
    "to": "back_low_r.in"
   },
   {
    "from": "edit_high.out",
    "to": "back_high_r.in"
   },
   {
    "from": "back_low_r.out",
    "to": "sum_r.in"
   },
   {
    "from": "back_high_r.out",
    "to": "sum_r.in2"
   },
   {
    "from": "sum_r.out",
    "to": "result.in"
   },
   {
    "from": "picture.out",
    "to": "pic_g.in"
   },
   {
    "from": "blur.out",
    "to": "low_g.in"
   },
   {
    "from": "pic_g.out",
    "to": "high_g.in"
   },
   {
    "from": "low_g.out",
    "to": "high_g.in2"
   },
   {
    "from": "high_g.out",
    "to": "high.in2"
   },
   {
    "from": "edit_low.out",
    "to": "back_low_g.in"
   },
   {
    "from": "edit_high.out",
    "to": "back_high_g.in"
   },
   {
    "from": "back_low_g.out",
    "to": "sum_g.in"
   },
   {
    "from": "back_high_g.out",
    "to": "sum_g.in2"
   },
   {
    "from": "sum_g.out",
    "to": "result.in2"
   },
   {
    "from": "picture.out",
    "to": "pic_b.in"
   },
   {
    "from": "blur.out",
    "to": "low_b.in"
   },
   {
    "from": "pic_b.out",
    "to": "high_b.in"
   },
   {
    "from": "low_b.out",
    "to": "high_b.in2"
   },
   {
    "from": "high_b.out",
    "to": "high.in3"
   },
   {
    "from": "edit_low.out",
    "to": "back_low_b.in"
   },
   {
    "from": "edit_high.out",
    "to": "back_high_b.in"
   },
   {
    "from": "back_low_b.out",
    "to": "sum_b.in"
   },
   {
    "from": "back_high_b.out",
    "to": "sum_b.in2"
   },
   {
    "from": "sum_b.out",
    "to": "result.in3"
   },
   {
    "from": "high.out",
    "to": "edit_high.in"
   },
   {
    "from": "alpha.out",
    "to": "result.alpha"
   }
  ],
  "controls": [
   {
    "label": "Radius",
    "drives": [
     "blur.radius"
    ],
    "range": [
     0,
     200
    ]
   },
   {
    "label": "High gain",
    "drives": [
     "high_r.scale",
     "high_g.scale",
     "high_b.scale"
    ],
    "range": [
     0,
     2
    ]
   }
  ]
 },
 "image_arithmetic": {
  "heeler_recipe": 1,
  "name": "Image Arithmetic",
  "description": "Two pictures combined by the numbers, channel by channel: add, subtract, multiply or divide, negatives kept, alpha from A",
  "keywords": "add subtract multiply divide math difference",
  "inputs": [
   {
    "port": "in",
    "to": [
     "a.in"
    ]
   },
   {
    "port": "in2",
    "to": [
     "b.in"
    ]
   }
  ],
  "output": "join",
  "nodes": [
   {
    "id": "a",
    "type": "heeler.merge",
    "name": "A",
    "at": [
     0,
     100
    ]
   },
   {
    "id": "b",
    "type": "heeler.merge",
    "name": "B",
    "at": [
     0,
     300
    ]
   },
   {
    "id": "a_alpha",
    "type": "heeler.measure",
    "name": "A alpha",
    "at": [
     170,
     0
    ],
    "params": {
     "metric": "alpha"
    }
   },
   {
    "id": "a_r",
    "type": "heeler.measure",
    "name": "A Red",
    "at": [
     170,
     100
    ],
    "params": {
     "metric": "red"
    }
   },
   {
    "id": "b_r",
    "type": "heeler.measure",
    "name": "B Red",
    "at": [
     340,
     200
    ],
    "params": {
     "metric": "red"
    }
   },
   {
    "id": "op_r",
    "type": "heeler.math",
    "name": "Red A op B",
    "at": [
     510,
     100
    ],
    "params": {
     "op": "add"
    }
   },
   {
    "id": "a_g",
    "type": "heeler.measure",
    "name": "A Green",
    "at": [
     170,
     200
    ],
    "params": {
     "metric": "green"
    }
   },
   {
    "id": "b_g",
    "type": "heeler.measure",
    "name": "B Green",
    "at": [
     340,
     300
    ],
    "params": {
     "metric": "green"
    }
   },
   {
    "id": "op_g",
    "type": "heeler.math",
    "name": "Green A op B",
