       },
       {
        "target": "op_b.op",
        "value": "multiply"
       }
      ]
     },
     {
      "label": "Divide",
      "set": [
       {
        "target": "op_r.op",
        "value": "divide"
       },
       {
        "target": "op_g.op",
        "value": "divide"
       },
       {
        "target": "op_b.op",
        "value": "divide"
       }
      ]
     }
    ]
   }
  ]
